# Large, immutable artifacts. Install git-lfs before adding these files.
data/processed/**/*.parquet filter=lfs diff=lfs merge=lfs -text
data/archives/**/*.zip filter=lfs diff=lfs merge=lfs -text
checkpoints/**/*.pt filter=lfs diff=lfs merge=lfs -text
checkpoints/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text

# Stable text normalization
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.sh text eol=lf
